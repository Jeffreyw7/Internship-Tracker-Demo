# Local Compose only. Copy to .env and replace all password placeholders with distinct secrets.
# Existing volumes: follow docs/DATABASE-SECURITY.md BEFORE starting the new stack.
DATABASE_ADMIN_USERNAME=campus_admin
DATABASE_ADMIN_PASSWORD=replace-with-a-distinct-admin-password
MIGRATION_DATABASE_PASSWORD=replace-with-a-distinct-migration-password
DATABASE_PASSWORD=replace-with-a-distinct-runtime-password
MAIL_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-mail-worker-password
EXPORT_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-export-worker-password
# Compose supplies synthetic local verification keys and a capture mailbox.
# Replicated Redis sessions/limits require the complete compose.scalable.yaml topology.
# Regular compose.yaml is a single-host PostgreSQL setup with a dedicated export worker.
REDIS_PASSWORD=replace-with-a-distinct-redis-password
SESSION_NAMESPACE=campus:compose:session:v1
AUTH_ADMISSION_NAMESPACE=campus:compose:admission:v1
AUTH_ADMISSION_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters

# Portable qualification: prefer `npm run test:distributed`, which generates these
# secrets in an isolated fixture and removes only its own volumes afterwards.
# For manual compose.scalable.yaml use, supply these privately as well.
INGRESS_PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
INGRESS_SUBNET=172.30.90.0/24
INGRESS_DYNAMIC_RANGE=172.30.90.128/25
INGRESS_ADDRESS=172.30.90.2
TRUSTED_PROXY_REGEX=^172\.30\.90\.2$
OUTBOX_KEY_ID=local-private-capture
OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
VERIFICATION_RATE_LIMIT_SECRET=replace-with-an-independent-random-secret
METRICS_TOKEN=replace-with-an-independent-metrics-bearer-token
EXPORT_API_ACCESS_KEY=replace-with-private-read-only-access-key
EXPORT_API_SECRET_KEY=replace-with-private-read-only-secret
EXPORT_WORKER_ACCESS_KEY=replace-with-private-worker-access-key
EXPORT_WORKER_SECRET_KEY=replace-with-private-worker-secret
# A private JSON identity file with read-only API / bucket-scoped worker actions.
# Do not commit it or give an anonymous identity access.
S3_CREDENTIALS_FILE=replace-with-absolute-path-to-private-identity-file
