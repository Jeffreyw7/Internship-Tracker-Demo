# Local Compose only. Copy to .env and replace all password placeholders with distinct secrets.
# Existing volumes: follow docs/DATABASE-SECURITY.md BEFORE starting the new stack.
DATABASE_ADMIN_USERNAME=campus_admin
DATABASE_ADMIN_PASSWORD=replace-with-a-distinct-admin-password
MIGRATION_DATABASE_PASSWORD=replace-with-a-distinct-migration-password
DATABASE_PASSWORD=replace-with-a-distinct-runtime-password
MAIL_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-mail-worker-password
EXPORT_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-export-worker-password
# Compose supplies synthetic local verification keys and a capture mailbox.
# Optional: docker compose --profile distributed up --build
# Set SPRING_PROFILES_ACTIVE=prod,distributed to opt the app into shared sessions/limits.
REDIS_PASSWORD=replace-with-a-distinct-redis-password
SESSION_NAMESPACE=campus:compose:session:v1
REDIS_MAX_MEMORY=256mb
AUTH_ADMISSION_NAMESPACE=campus:compose:admission:v1
AUTH_ADMISSION_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
